{
  "expo": {
    "name": "PineForest",
    "slug": "pineforest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thepines.pineforest",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "package": "ai.pineforest.app"
    },
    "owner": "thepines",
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ca44c9c2-b82c-4a3a-816a-7f00739ec509"
      }
    }
  }
}
