{
  "expo": {
    "name": "InkThis",
    "slug": "inkthis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.inkthis.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "package": "ai.inkthis.app"
    },
    "owner": "thepines",
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "8ec32b3f-868e-4f12-b393-4ca677fd6257"
      }
    }
  }
}
